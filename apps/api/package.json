{
  "name": "@yato/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node $(test -f .env && echo --env-file=.env)\" | pino-pretty",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@orpc/contract": "^1.16.2",
    "@orpc/nest": "^1.16.2",
    "@orpc/server": "^1.16.2",
    "@yato/contract": "workspace:*",
    "amqplib": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
