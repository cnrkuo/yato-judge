{
  // Base URL of the YATO Judge API (apps/api).
  "api_url": "http://127.0.0.1:3001",
  // Create a judge under Admin → Judges in the web UI and paste its token.
  // YATO_JUDGE_TOKEN in the environment takes precedence.
  "token": "yato_judge_REPLACE_ME",

  "work_dir": "/var/lib/yato-judge/work",
  "cache_dir": "/var/lib/yato-judge/cache",
  // Long polling: the API holds a fetch open up to this many seconds (30 at
  // most) and answers as soon as a submission is queued. 0 asks without
  // waiting, every poll_interval_ms.
  "fetch_wait_sec": 25,
  // Least time between two fetches that found nothing.
  "poll_interval_ms": 1000,

  // Identity submissions run as when the judge is started as root.
  "run_uid": 65534,
  "run_gid": 65534,
  // nsjail binary (judge/scripts/install-nsjail.sh); a bare name is looked up in PATH.
  "nsjail_path": "/usr/local/bin/nsjail",
  // Enforce memory limits with a cgroup per run (needs root and a writable
  // cgroup filesystem; otherwise the judge falls back to rlimits and says why).
  "memory_cgroup": true,
  "cgroup_root": "/sys/fs/cgroup",

  "output_limit_kb": 65536,
  "compile_time_ms": 15000,
  "compile_memory_kb": 2097152,
  "max_processes": 64,

  // Problems may come with a checker: a C++ program, usually written with
  // testlib.h, that decides whether an output is right. It is compiled once
  // (and cached) with a copy of testlib.h next to it, then run in the sandbox
  // as `checker <input> <output> <answer>` after every testcase.
  "testlib_path": "/usr/local/share/yato-judge/testlib.h",
  "checker_time_ms": 10000,
  "checker_memory_kb": 1048576
  // "checker_compile": ["/usr/bin/g++", "-std=c++20", "-O2", "-o", "checker", "checker.cpp"],

  // Optional: override or add languages. Keys are the API's language ids
  // (c, cpp, cpp23, clang-cpp17, clang-cpp23, py3). At start-up every
  // language is compiled and run once; those that fail are not offered.
  // "languages": {
  //   "cpp": {
  //     "source": "main.cpp",
  //     "compile": ["/usr/bin/g++", "-std=c++20", "-O2", "-o", "main", "main.cpp"],
  //     "run": ["./main"]
  //   }
  // }
}
